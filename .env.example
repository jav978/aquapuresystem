# Database
DATABASE_URL=postgresql://aqua:aquasystem@localhost:5432/aquasystem
DB_PASSWORD=aquasystem

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Email (optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@aquasystem.com
SMTP_PASS=password

# File Storage
STORAGE_TYPE=local
S3_BUCKET=aquasystem-files
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Frontend
NUXT_PUBLIC_API_URL=http://localhost:3030
NUXT_PUBLIC_WS_URL=ws://localhost:3030