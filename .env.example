# ==============================================================================
# AquaPureSystem - Variables de Entorno (Conexión Directa / Sin Requerir Docker)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL)
# Conéctese directamente a su instancia local o remota de PostgreSQL
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aquasystem?schema=public"
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=aquasystem

# ------------------------------------------------------------------------------
# 2. Caché y Sesiones (Redis)
# Conéctese directamente a su instancia local o remota de Redis
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# 3. Servidor Backend API (Feathers.js v5)
# ------------------------------------------------------------------------------
PORT=3030
NODE_ENV=development

# ------------------------------------------------------------------------------
# 4. Autenticación y Seguridad (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET="aquapure-super-secret-jwt-key-min-32-chars-2026"
JWT_REFRESH_SECRET="aquapure-super-secret-refresh-jwt-key-min-32-chars-2026"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 5. Frontend (Nuxt 4 + Tailwind CSS)
# ------------------------------------------------------------------------------
NUXT_PUBLIC_API_URL=http://localhost:3030
NUXT_PUBLIC_WS_URL=ws://localhost:3030

# ------------------------------------------------------------------------------
# 6. Almacenamiento de Archivos (Local / S3)
# ------------------------------------------------------------------------------
STORAGE_TYPE=local
S3_BUCKET=aquasystem-files
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ------------------------------------------------------------------------------
# 7. Notificaciones y Correo SMTP (Opcional)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@aquasystem.com
SMTP_PASS=password
SMTP_FROM="AquaPure System <noreply@aquasystem.com>"