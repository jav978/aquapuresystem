{
  "name": "@aquasystem/web",
  "version": "0.0.0",
  "description": "AquaSystem Web - Nuxt 4 Frontend",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 3000",
    "start": "node .output/server/index.mjs",
