{
  "name": "@aquasystem/design-system",
  "version": "0.0.0",
  "description": "Design System for AquaSystem - Tokens, Components, Composables",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./src/index.ts"
    },
    "./tokens": {
      "types": "./src/tokens/index.ts",
      "import": "./src/tokens/index.ts",
      "require": "./src/tokens/index.ts"
    },
    "./tailwind": {
      "types": "./src/tailwind/index.ts",
      "import": "./src/tailwind/index.ts",
      "require": "./src/tailwind/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts",
      "require": "./src/components/index.ts"
    },
    "./composables": {
      "types": "./src/composables/index.ts",
      "import": "./src/composables/index.ts",
      "require": "./src/composables/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts",
      "require": "./src/utils/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build",
    "dev": "vite build --watch",
    "lint": "eslint src --ext .ts,.vue",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@vueuse/core": "^10.9.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "tailwindcss": "^3.4.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@storybook/vue3": "^8.0.0",
    "@vue/compiler-sfc": "^3.4.0",
    "storybook": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^1.4.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}